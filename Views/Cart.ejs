<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="../Styles/cart.css"/>
  <title>Cart</title>
</head>

<body class="bg">
    <header>
      <nav class="navbar">
        <div class="logo">
            <a href="/"><img src="/Icons/Craftify.png" alt="Logo"></a>
        </div>
        <div class="nav-items">
             <div class="dropdown">
                <a href="#" class="account"> Account </a>
                <div class="dropdown-menu">
                    <a href="/details" class="account">Account Details</a>
                    <a href="/Pastorders" class="account">Past Orders</a>
                    <a href="/Likeditem" class="account">Liked Items</a>
                    <a href="/logoff" class="account">Log Out</a>
                </div>
            </div>
            <a href="/Cart"><img src="/Icons/Cart.png" alt="Cart"></a>
            <a href="/account"><img src="/Icons/Profile.png" alt="Profile"></a>
        </div>
    </nav>
    </header>

<main>
  <h1>Shopping Cart</h1>

  <div id="products" class="cart-container">
    <% cart.forEach((item, index) => { %>
      <div class="cart-item">
        <img src="../Icons/<%= item.productName %>.webp" alt="<%= item.productName %>">
        <div class="item-details">
          <h4><%= item.productName %></h4>
          <% if (item.model) { %>
            <p><%= item.model %></p>
          <% } else if (item.size) { %>
            <p><%= item.size %></p>
          <% } %>
          <p>Logo: <%= item.logo %></p>

          <p><strong> $<%= item.price %> </strong></p>
          
          <form action="/cart/update" method="POST">
            <input type="hidden" name="index" value="<%= index %>" />
            <label>Qty: <input type="number" name="quantity" class="quantity" value="<%= item.quantity %>" min="1"></label>
            <button type="submit">Update</button>
          </form>

          <form action="/cart/remove" method="POST">
            <input type="hidden" name="index" value="<%= index %>" />
            <button type="submit">Remove</button>
          </form>

        </div>
      </div>
    <% }); %>

    <% if (cart.length === 0) { %>
      <p>The Cart is empty</p>
    <% } %>
  </div>

  <div class="summary">
    <p>Subtotal: <span id="subtotal">$<%= subtotal %></span></p>
    <p>Shipping: <span id="shipping">$<%= shipping %></span></p>
    <p>Tax: <span id="tax">$<%= tax %></span></p>
    <p><strong>Total: <span id="total">$<%= total %></span></strong></p>
    <a href="/checkout"><button id="checkout-btn">Checkout</button></a>
  </div>

</main>

<footer>
  <p class="ftext"> Copyright © 2025 Craftify </p>
  <div>
      <a href="/CS"> <img src="../Icons/CustomerService.png" alt="CustomerService" class="customer"> </a>
  </div>  
</footer>

<script>
  window.addEventListener('DOMContentLoaded', () => {
      let cartTotal = 0;

      // Loop through each item in the cart to calculate the total
      document.querySelectorAll('.cart-item').forEach(item => {
          const price = parseFloat(item.querySelector('.item-details p strong').textContent.replace('$', ''));
          const quantity = parseInt(item.querySelector('.quantity').value);
          cartTotal += price * quantity;
      });

      // Store the total amount in localStorage
      localStorage.setItem("cartTotal", cartTotal.toFixed(2));

      // Optionally, you can display the total in the cart page as well
      document.getElementById("cart-total").textContent = `$${cartTotal.toFixed(2)}`;
  });
</script>





</body>
</html>


<!DOCTYPE html>
<html lang="en" dir="ltr">


  <head>
    <meta charset="utf-8" />
    <title>Customer Service</title>
    <link rel="stylesheet" href="Styles/Customer.css"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@48,400,0,0" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,400,1,0" />
    <%- include('chatScript.ejs') %>
  </head>


  <body>
    <div class="div1">
      <a href="/">
    <img src="../Icons/Craftify.png" alt="logo" class="logoclass">
      </a>  
    </div>

    <button class="chatbot-toggler" onclick="toggleChatBot()">
      <span class="material-symbols-rounded">mode_comment</span>
      <span class="material-symbols-outlined">close</span>
    </button>

    <div class="chatbot ">
      <header>
        <h2>Craftify Support</h2>
        <span class="close-btn material-symbols-outlined">close</span>
      </header>
      <ul class="chatbox">
        <li class="chat incoming">
          <span class="material-symbols-outlined">smart_toy</span>
          <p>Hi there 👋<br />select one of out FAQs</p>
        </li>
        <div class="buttons-container">

          <button onclick="buttonClick(event)" value="What's the most popular item?">What's the most popular item?</button>
          <button onclick="buttonClick(event)" value="How long can it take for a refund?">How long can it take for a refund?</button>
        </div>
      </ul>
      <div class="chat-input">
      <form  onsubmit="handleChatBotForm(event)">
        <textarea id="message" placeholder="Enter a message..." spellcheck="false" name="message" required></textarea>
        <button type="submit" id="send-btn" class="material-symbols-rounded">send</button>
      </form>
      </div>
    </div>
  </body>



</html>


<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Customer Service</title>


  <link rel="stylesheet" href="../Styles/Customer.css"/>


</head>
<body class="bg">

  <header>
    <nav class="navbar">
        <div class="logo">
            <a href="/"><img src="/Icons/Craftify.png" alt="Logo"></a>
        </div>

        <div class="nav-items">

            <div class="dropdown">
                <a href="#" > Account </a>
                <div class="dropdown-menu">
                    <a href="/details">Account Details</a>
                    <a href="/Pastorders">Past Orders</a>
                    <a href="/Likeditem">Liked Items</a>
                    <a href="#">Log Out</a>
                </div>
            </div>

            <img src="/Icons/Cart.png" alt="Cart">
            <img src="/Icons/Profile.png" alt="Profile">
        </div>
    </nav>

</header>


<main>
  <div class="chat-window">
    <div class="chat-header">
      <span>Chat</span>
    </div>
    <div class="chat-body">
      <p><strong>Hi!</strong> Welcome to <em>(Craftify)</em>. I'm your virtual assistant. While I'm not human, I can still answer questions. What would you like to chat about today?</p>
    </div>
    <div class="chat-footer">
      <input type="text" placeholder="Type your question here">
      <button>➤</button>
    </div>
  </div>
</main>


  <footer>
    <div class="fdiv">
        <div >
            <p class="divfooter"> Copyright © 2025 Craftify </p>
        </div>  
    </div>
  </footer>

  
</body>
</html>
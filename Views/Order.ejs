<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Past Orders</title>
    <link rel="stylesheet" href="../Styles/PastOrders.css" />
</head>

<header>
    <div class="navdiv">
        <a href="/"> <img src="../Icons/Craftify.png" class="navimg"> </a>
        <nav>
            <div class="navdiv">
                <div>
                    <a href="/Cart"><img src="../Icons/Cart.png" class="divimg"></a>
                </div>

                <div>
                    <a href="/Profile"><img src="../Icons/Profile.png" class="divimg"></a>
                </div>
            </div>
        </nav>
    </div>
</header>

<body>

    <main>
        <h1>Past Orders</h1>

        <div class="container">

            <div class="date-picker">
                <label>Date Ordered</label>
                <input type="date">
            </div>

            <div class="orders">

                <% if (orders && orders.length > 0) { %>
                    <% orders.forEach(order => { %>
                        <div class="order-item">
                            <p><%= order.orderDate %></p>
                            <img class="images" src="<%= order.productImage %>" alt="<%= order.productName %>">
                            <p><%= order.productName %></p>
                            <p>Price: $<%= order.price %></p>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p>No Past Orders Available</p>
                <% } %>

            </div>

        </div>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Past Orders</title>
    <link rel="stylesheet" href="../Styles/PastOrders.css" />
</head>

<header>
    <div class="navdiv">
        <a href="/"> <img src="../Icons/Craftify.png" class="navimg"> </a>
        <nav>
            <div class="navdiv">
                <div>
                    <a href="/Cart"><img src="../Icons/Cart.png" class="divimg"></a>
                </div>

                <div>
                    <a href="/Profile"><img src="../Icons/Profile.png" class="divimg"></a>
                </div>
            </div>
        </nav>
    </div>
</header>

<body>

    <main>
        <h1>Past Orders</h1>

        <div class="container">

            <div class="orders">

                <% if (message) { %>
                    <p><%= message %></p>
                <% } else if (orders && orders.length > 0) { %>
                    <% orders.forEach(order => { %>
                        <div class="order-item">

                            <p><strong>Purchased:</strong> <%= new Date(order.oDate).toLocaleDateString('en-US') %></p>
                            <img class="images" src="../Icons/<%= order.prDescription %>.webp" alt="<%= order.prDescription %>">

                            <p><strong>Product:</strong> <%= order.productName %></p>
                            <p><strong>Color:</strong> <%= order.color %></p>
                            <p><strong>Price:</strong> $<%= order.Price %></p>

                            <% if (order.logo === "Blank") { %>
                                <p><strong>Logo:</strong> <%= order.logo %></p>
                            <% } else { %>
                                <p><strong>Logo:</strong></p>
                                <img class="images" src="../Logos/<%= order.logo %>.png" alt="<%= order.logo %>">
                            <% } %>

                            <p><strong>Quantity:</strong> <%= order.quantity %></p>
                            <p><strong><%= order.detailType %>:</strong> <%= order.detail %></p>

                        </div>
                    <% }); %>
                <% } %>

            </div>

        </div>

    </main>

    <footer>
        <p class="ftext"> Copyright © 2025 Craftify </p>
        <div>
            <a href="/CS"> <img src="../Icons/CustomerService.png" alt="CustomerService" class="customer"> </a>
        </div>
    </footer>

</body>

</html>

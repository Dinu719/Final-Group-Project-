<!DOCTYPE html>
<html lang="en">


    <head>
        <title>Account Details</title>
        <link rel="stylesheet" href="../Styles/AD.css"/>
    </head>


<body>
    
    <header>
        
        <div class="navdiv"> 
            <a href="/"> <img src="../Icons/Craftify.png" class="navimg"> </a>
                <nav >
                    <div class="navdiv">
                        <div> 
                            <ul>
                                <li><button class="btn-grad" ><a href="/profile">Account</a></button></li>
                            </ul>
                        </div>
    
                        <div >
                            <a href="/Cart"><img src="../Icons/Cart.png" class="divimg"></a>
                        </div>
     
                        <div>
                            <a href="/Checkout"><img src="../Icons/Profile.png" class="divimg"></a>
                        </div>
                    </div>
                </nav>
         </div>
 
     </header>
        

<main>


<h1>Account Details</h1>
<section class="container">
<form action="/update" method="post">
<label for="fullName">Full Name</label><br />
<input type="text" id="fullName" name="fullName" value="<%= fullName %>" placeholder="Enter your Full Name"><br />
<label for="emailAddress">Email Address</label><br />
<input type="text" id="emailAddress" name="emailAddress" value="<%= emailAddress %>" placeholder="Enter your Email Address"><br />
<label for="DOB">DOB</label><br />
<input type="date" id="DOB" name="DOB" value="<%= DOB %>"><br />
<label for="phoneNumber">Phone Number</label><br />
<input type="tel" id="phoneNumber" name="phoneNumber" value="<%= phoneNumber %>" placeholder="Enter your Phone Number"><br />
<label for="password">Password</label><br />
<input type="text" id="password" name="password" value="<%= password %>" placeholder="Enter your Password"><br />
<button type="submit" class="btn">Save Changes</button>
</form>
</section>


</main>

<footer>
    
        <p class="ftext"> Copyright © 2025 Craftify </p>

        <div>
            <a href="/CS"> <img src="../Icons/CustomerService.png" alt ="CustomerService" class="customer"> </a>
        </div>  

</footer>

</body>

</html>
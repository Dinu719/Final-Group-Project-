<!DOCTYPE html>
<html lang="en">
<head>
<title>Account Details</title>
<link rel="stylesheet" href="../Styles/AD.css"/>
</head>
<body>
<header>
    <header>
        <div class="navbar">
        <div class="navdiv"> 
            <a href="/"><img src="../Icons/Craftify.png" alt ="Logo"></a>
                <nav >
                    <div class="navdiv">
                            <div >
                                <a href="/Cart"><img src="../Icons/Cart.png" class="divimg"></a>
                            </div>
    
                            <div>
                                <img src="../Icons/Profile.png" class="divimg">
                            </div>
                    </div>
    
                    <div>
                        <ul>
                            <li><a href="/signin">Sign In/Up</a></li>
                            <li><a href="/profile">Account</a></li>
                        </ul>
                    </div>
                
                </nav>
        </div>
        </div>
    </header>
</header>
<main>
<h1>Account Details</h1>
<p>🡠 <a href="/profile">Profile</a></p>
<section class="container">
<form action="/update-account" method="post">
<label for="fullName">Full Name</label><br />
<input type="text" id="fullName" name="fullName" value="John Doe" placeholder="Enter your Full Name" required><br />
<label for="emailAddress">Email Address</label><br />
<input type="text" id="emailAddress" name="emailAddress" value="johndoe@email.com" placeholder="Enter your Email Address" required><br />
<label for="DOB">DOB</label><br />
<input type="date" id="DOB" name="DOB" value="2000-01-01"><br />
<label for="phoneNumber">Phone Number</label><br />
<input type="tel" id="phoneNumber" name="phoneNumber" value="123-456-7890" placeholder="Enter your Phone Number" required><br />
<label for="password">Password</label><br />
<input type="password" id="password" name="password" value="QWer12#$" placeholder="Enter your Password" required><br />
</form>
</section>
<button type="submit" class="btn">Save Changes</button>
</main>
<footer>
    <div class="fdiv">
        <div >
            <p class="divfooter"> Copyright © 2025 Craftify </p>
        </div>

        <div>
            <a href="/CS"> <img src="../Icons/CustomerService.png" alt ="CustomerService" class="customer"> </a>
        </div>  
    </div>
</footer>
</body>
</html>

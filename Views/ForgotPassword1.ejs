<!DOCTYPE html>
<html lang="en">
<head>
  <title>Forgot Password</title>
  <link rel="stylesheet" href="../Styles/FP.css"/>
</head>
<header>
<a href="/"><img src="../Icons/Craftify.png" alt ="Logo" ></a>
</header>
<body class="bg">

  <main>

      <h4>Verify Identity to Reset Your Password</h4>
      <hr>
      <form action="/forgot-password" method="post">
        <label for="emailAddress">Email Address</label><br />
        <input type="text" id="emailAddress" name="emailAddress" placeholder="Enter your Email Address" required><br />
        <label for="securityPIN">Security PIN</label><br />
        <input type="password" id="securityPIN" name="securityPIN" placeholder="Enter a Four-Digit PIN" required><br />
      </form>
      <a href="/password2"><button type="submit" class="btn1">Reset Password</button></a>

  </main>

  <a href="/signin"><button class="btn2"> Returning User? </button></a><br>
  <a href="/signup"><button class="btn2"> New User? </button></a>

</body>
<footer>
  <div class="fdiv">
    <div>
      <p class="divfooter"> Copyright © 2025 Craftify </p>
    </div>
  </div>
</footer>
</html>

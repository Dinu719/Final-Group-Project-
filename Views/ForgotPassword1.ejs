<!DOCTYPE html>
<html lang="en">
<head>
  <title>Forgot Password</title>
  <link rel="stylesheet" href="../Styles/FP.css"/>
</head>
<header>
<a href="/"><img src="../Icons/Craftify.png" alt ="Logo" ></a>
</header>
<body class="bg">

  <main>

      <h4>Please Verify Your Identity</h4>
      <br><hr><br>
      <form action="/forgot" method="post">
        <label for="email">Email</label><br>
        <input type="text" id="email" name="email" placeholder="Enter your Email Address" required><br>
        <button type="submit" class="btn1">Reset Password</button>
      </form>

  </main>

  <a href="/signin"><button class="btn2"> Returning User? </button></a><br>
  <a href="/signup"><button class="btn2"> New User? </button></a>

</body>
<footer>
  <div class="fdiv">
    <div>
      <p class="divfooter"> Copyright © 2025 Craftify </p>
    </div>
  </div>
</footer>
</html>

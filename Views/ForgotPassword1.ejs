<!DOCTYPE html>
<html lang="en">
<head>
  <title>Forgot Password</title>
  <link rel="stylesheet" href="../Styles/FP.css"/>
</head>
<header>
<a href="/"><img src="../Icons/Craftify.png" alt ="Logo" ></a>
</header>
<body class="bg">

  <main>

      <h4>Verify Identity to Reset Your Password</h4>
      <hr>
      <form action="/forgot-password" method="post">
        <label for="email">Email</label><br />
        <input type="text" id="email" name="email" placeholder="Enter your Email Address" required><br />
        <label for="securityPIN">Security PIN</label><br />
        <input type="password" id="securityPIN" name="securityPIN" placeholder="Enter a Four-Digit PIN" required><br />
        <button type="submit" class="btn">Reset Password</button></a>
      </form>

  </main>

  <a href="/signin"><button class="btn"> Returning User? </button></a><br>
  <a href="/signup"><button class="btn"> New User? </button></a>

</body>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clothing</title>
  <link rel="stylesheet" href="../Styles/clothing.css" />
</head>

<body>

  <header>
    <div class="navdiv">
      <a href="/"> <img src="../Icons/Craftify.png" class="navimg"> </a>
      <nav>
        <div class="navdiv">
          <div>
            <a href="/Cart"><img src="../Icons/Cart.png" class="divimg"></a>
          </div>

          <div>
            <a href="/account">
              <img src="../Icons/Profile.png" class="divimg" alt="Profile">
            </a>
          </div>
        </div>
      </nav>
    </div>
  </header>

  <main>
    <br>

    <h1>Clothing</h1>

    <div class="container">

      <div class="product-category">
        <h2>Hoodies</h2>
        <div class="products">
          <% hoodies.forEach(product => { %>
            <div class="product-item">
              <img class="images" src="../Icons/<%= product.prDescription %>.webp" alt="<%= product.prDescription %>">
              <p>Price: $<%= product.Price %></p>
              <p>Quantity: <input type="number" name="num" min="1" max="<%= product.Stock %>" value="1" /></p>
              <p>Size: 
                <select>
                  <option>Small</option>
                  <option>Medium</option>
                  <option>Large</option>
                  <option>X-Large</option>
                </select>
              </p>
              <p>Color: <%= product.color %></p>
              <p>Logo: 
                <select>
                  <% hoodieLogos.forEach(logo => { %>
                    <option value="<%= logo.loID %>"><%= logo.loName %></option>
                  <% }); %>
                </select>
              </p>
              <div class="buttons">
                <button>Add to Cart</button>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    
      <div class="product-category">
        <h2>T-Shirts</h2>
        <div class="products">
          <% tShirts.forEach(product => { %>
            <div class="product-item">
              <img class="images" src="../Icons/<%= product.prDescription %>.webp" alt="<%= product.prDescription %>">
              <p>Price: $<%= product.Price %></p>
              <p>Quantity: <input type="number" name="num" min="1" max="<%= product.Stock %>" value="1" /></p>
              <p>Size: 
                <select>
                  <option>Small</option>
                  <option>Medium</option>
                  <option>Large</option>
                  <option>X-Large</option>
                </select>
              </p>
              <p>Color: <%= product.color %></p>
              <p>Logo: 
                <select>
                  <% tShirtLogos.forEach(logo => { %>
                    <option value="<%= logo.loID %>"><%= logo.loName %></option>
                  <% }); %>
                </select>
              </p>
              <div class="buttons">
                <button>Add to Cart</button>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    
    </div>
    

  </main>

  <footer>
    <p class="ftext"> Copyright © 2025 Craftify </p>
    <div>
      <a href="/CS"> <img src="../Icons/CustomerService.png" alt="CustomerService" class="customer"> </a>
    </div>
  </footer>

</body>

</html>

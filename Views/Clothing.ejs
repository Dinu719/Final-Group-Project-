<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Clothing</title>

<link rel="stylesheet" href="../Styles/clothing.css"/>

</head>

<body class="bg">

<header>
    <nav class="navbar">
        <div class="logo">
            <a href="/"><img src="/Icons/Craftify.png" alt="Logo"></a>
        </div>

        <div class="nav-items">

            <div class="dropdown">
                <a href="#">Account </a>
                <div class="dropdown-menu">
                    <a href="/details">Account Details</a>
                    <a href="/Pastorders">Past Orders</a>
                    <a href="/Likeditem">Liked Items</a>
                    <a href="#">Log Out</a>
                </div>
            </div>

            <img src="/Icons/Cart.png" alt="Cart">
            <img src="/Icons/Profile.png" alt="Profile">
        </div>
    </nav>

</header>



<main>

<h1 >Clothing</h1>

<div class="container">

<div class="product">

<h2>Hoodie</h2>

<img class="images" src="../Icons/Hoodie.webp" alt="Hoodie">

<p>Price: $20</p>

<p>Quantity: <select><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option></select></p>

<p>Size: <select><option>Small</option><option>Medium</option><option>Large</option><option>X-Large</option></select></p>

<p>Color: <select><option>Black</option><option>Gray</option><option>Blue</option><option>Red</option></select></p>

<p>Logo: <select><option>Blank</option><option>Flames</option><option>Clouds</option><option>Floret</option><option>Cross</option></select></p>

<button class="cart-btn">Add to Cart</button>

<button class="like-btn">Like</button>

</div>

<div class="product">

<h2>T-Shirt</h2>

<img class="images" src="../Icons/T-Shirt.jpeg" alt="T-Shirt">

<p>Price: $10</p>

<p>Quantity: <select><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option></select></p>

<p>Size: <select><option>Small</option><option>Medium</option><option>Large</option><option>X-Large</option></select></p>

<p>Color: <select><option>Black</option><option>Gray</option><option>Blue</option><option>Red</option></select></p>

<p>Logo: <select><option>Blank</option><option>Flames</option><option>Clouds</option><option>Floret</option><option>Cross</option></select></p>

<button class="cart-btn">Add to Cart</button>

<button class="like-btn">Like</button>

</div>

</div>

</main>

<footer>
    <div class="fdiv">
        <div >
            <p class="divfooter"> Copyright © 2025 Craftify </p>
        </div>

        <div>
            <a href="/CS"> <img src="../Icons/CustomerService.png" alt ="CustomerService" class="customer"> </a>
        </div>  
    </div>
</footer>

</body>

</html>

<script type="text/javascript">
    var cart = []
    try{
        cart = JSON.parse(localStorage["cart"])
    }
    catch{
        cart = []
    }
    const selectedcolor= document.getElementById("color")
    const selectedlogo= document.getElementById("logo")
    const selectedsize= document.getElementById("size")
    const selectedquantity= document.getElementById("quantity")
    const selectedcolor2= document.getElementById("color2")
    const selectedlogo2= document.getElementById("logo2")
    const selectedsize2= document.getElementById("size2")
    const selectedquantity2= document.getElementById("quantity2")




    const cart1 = document.getElementById("cart1")
    const cart2 = document.getElementById("cart2")
    cart1.onclick = (() => {
        cart.push({"name":"Hoodie", "quantity":selectedquantity.value, "size":selectedsize.value, "color":selectedcolor.value, "logo":selectedlogo.value})
        localStorage["cart"]= JSON.stringify(cart)
    })
    cart2.onclick = (() => {
        cart.push({"name":"T-Shirt", "quantity":selectedquantity2.value, "size":selectedsize2.value, "color":selectedcolor2.value, "logo":selectedlogo2.value})
        localStorage["cart"]=JSON.stringify(cart)
    })
</script>
<!DOCTYPE html>
<html lang="en">


<head>
        <title>Sign In</title>
        <link rel="stylesheet" href="../Styles/SignIn.css"/>
</head>

<body class="bg">

<header>
    
    <div class="logo">
        <a href="/"><img src="../Icons/Craftify.png" alt ="Logo" ></a>
    </div>

</header>



<main>

    <h2>Sign In</h2>
            <form action="/login" method="post">
                <label for="email">Email</label><br />
                    <input type="text" id="email" name="email" placeholder="Email" required><br />
                <label for="password">Password</label><br />
                    <input type="password" id="password" name="password" placeholder="Password" required><br />
                <button type="submit" class="btn">Sign In</button>
            </form>


<a href="/password1">Forgot Password?</a>

</main>

<a href="/signup"><button class = "btn"> New User? </button></a>


<footer>
    <div class="fdiv">
        <div >
            <p class="divfooter"> Copyright © 2025 Craftify </p>
        </div>  
    </div>
</footer>
</body>

<% if (errorMessage) { %>
    <script>
        alert('<%= errorMessage %>');
    </script>
<% } %>

</html>
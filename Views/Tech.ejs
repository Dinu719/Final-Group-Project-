<div class="container">

<div class="products">

<div class="product-item">

<p>Laptop Case</p>

<img src="" alt="Laptop Case">

<p>Quantity: <select><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option></select></p>

<p>Size: <select><option>11-12 in</option><option>13-14 in</option><option>15-16 in</option><option>17-18 in</option></select></p>

<p>Color: <select><option>Black</option><option>Gray</option><option>Blue</option><option>Red</option></select></p>


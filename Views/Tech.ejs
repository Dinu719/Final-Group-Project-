<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Technology</title>
  <link rel="stylesheet" href="../Styles/tech.css" />
</head>

<body>

  <header>
    <div class="navdiv">
      <a href="/"> <img src="../Icons/Craftify.png" class="navimg"> </a>
      <nav>
        <div class="navdiv">
          <div>
            <a href="/Cart"><img src="../Icons/Cart.png" class="divimg"></a>
          </div>

          <div>
            <a href="/account">
              <img src="../Icons/Profile.png" class="divimg" alt="Profile">
            </a>
          </div>
        </div>
      </nav>
    </div>
  </header>

  <main>
    <br>

    <h1>Technology</h1>

    <div class="container">
      <div class="products">
        <h2>Laptop Cases</h2>
        <% laptopCases.forEach(product => { %>
          <div class="product-item">
            <img class="images" src="../Icons/<%= product.prDescription %>.webp" alt="<%= product.prDescription %>">
            <p>Price: $<%= product.Price %></p>

            <form action="/cart/add" method="POST">
              <input type="hidden" name="productID" value="<%= product.prID %>" />
              <input type="hidden" name="productName" value="<%= product.prDescription %>" />
              <input type="hidden" name="price" value="<%= product.Price %>" />
              <input type="hidden" name="category" value="laptop" />

              <p>Quantity: <input type="number" name="quantity" min="1" max="<%= product.Stock %>" value="1" /></p>

              <p>Model: 
                <select name="model">
                  <option>11-12 in.</option>
                  <option>13-14 in.</option>
                  <option>15-16 in.</option>
                  <option>17-18 in.</option>
                </select>
              </p>

              <p>Color: <%= product.color %></p>

              <p>Logo: 
                <select name="logo">
                  <% laptopLogos.forEach(logo => { %>
                    <option value="<%= logo.loID %>"><%= logo.loName %></option>
                  <% }); %>
                </select>
              </p>

              <div class="buttons">
                <button type="submit">Add to Cart</button>
              </div>
            </form>
          </div>
        <% }); %>
      </div>

      <div class="products">
        <h2>iPhone Cases</h2>
        <% iPhoneCases.forEach(product => { %>
          <div class="product-item">
            <img class="images" src="../Icons/<%= product.prDescription %>.webp" alt="<%= product.prDescription %>">
            <p>Price: $<%= product.Price %></p>

            <form action="/cart/add" method="POST">
              <input type="hidden" name="productID" value="<%= product.prID %>" />
              <input type="hidden" name="productName" value="<%= product.prDescription %>" />
              <input type="hidden" name="price" value="<%= product.Price %>" />
              <input type="hidden" name="category" value="iphone" />

              <p>Quantity: <input type="number" name="quantity" min="1" max="<%= product.Stock %>" value="1" /></p>

              <p>Model: 
                <select name="model">
                  <option>iPhone 16</option>
                  <option>iPhone 16 Plus</option>
                  <option>iPhone 16 Pro</option>
                  <option>iPhone 16 Pro Max</option>
                </select>
              </p>

              <p>Color: <%= product.color %></p>

              <p>Logo: 
                <select name="logo">
                  <% iPhoneLogos.forEach(logo => { %>
                    <option value="<%= logo.loID %>"><%= logo.loName %></option>
                  <% }); %>
                </select>
              </p>

              <div class="buttons">
                <button type="submit">Add to Cart</button>
              </div>
            </form>
          </div>
        <% }); %>
      </div>

    </div>

  </main>

  <footer>
    <p class="ftext"> Copyright © 2025 Craftify </p>
    <div>
      <a href="/CS"> <img src="../Icons/CustomerService.png" alt="CustomerService" class="customer"> </a>
    </div>
  </footer>

</body>

</html>

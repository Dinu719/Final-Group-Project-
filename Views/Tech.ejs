<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Technology</title>

<link rel="stylesheet" href="../Styles/tech.css"/>

</head>

<body>

<div class="navbar">

